# =====================================================================
# Environment variable template for kolas.
#
# Override rules:
#   - The TOML filename in `config/` (without extension) is the first
#     segment, e.g. `APP__`.
#   - Nested levels are separated by a double underscore `__`.
#   - A single underscore `_` stays as part of the key name.
#   - Numbers and booleans are parsed automatically.
# =====================================================================

APP__NAME=Kolas
APP__DEBUG=true
APP__HOST=127.0.0.1
APP__PORT=3000
APP__URL=http://localhost:3000

DATABASE__DEFAULT=primary
DATABASE__CONNECTIONS__PRIMARY__HOST=127.0.0.1
DATABASE__CONNECTIONS__PRIMARY__PORT=5432
DATABASE__CONNECTIONS__PRIMARY__DATABASE=kolas
DATABASE__CONNECTIONS__PRIMARY__USERNAME=postgres
DATABASE__CONNECTIONS__PRIMARY__PASSWORD=

CACHE__DEFAULT=memory

QUEUE__DEFAULT=sync

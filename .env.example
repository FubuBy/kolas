# =====================================================================
# Environment variable template for kolas.
#
# Override rules:
#   - The TOML filename in `config/` (without extension) is the first
#     segment, e.g. `APP__`.
#   - Nested levels are separated by a double underscore `__`.
#   - A single underscore `_` stays as part of the key name.
#   - Numbers and booleans are parsed automatically.
#
# Optional — HTTP request tracing (tower-http TraceLayer + tracing-subscriber):
#   RUST_LOG=info,tower_http=trace
# =====================================================================

APP__NAME=Kolas
APP__DEBUG=true
APP__HOST=127.0.0.1
APP__PORT=3000
APP__URL=http://localhost:3000

# Default database connection — referenced by `Database::default()`.
DATABASE__DEFAULT=primary
DATABASE__AUTO_MIGRATE=false
DATABASE__MIGRATIONS_PATH=./database/migrations

# Primary connection (MySQL by default; the same shape works for Postgres
# with DRIVER=postgres and the appropriate port, see config/database.toml).
DATABASE__CONNECTIONS__PRIMARY__DRIVER=mysql
DATABASE__CONNECTIONS__PRIMARY__HOST=127.0.0.1
DATABASE__CONNECTIONS__PRIMARY__PORT=3306
DATABASE__CONNECTIONS__PRIMARY__DATABASE=kolas
DATABASE__CONNECTIONS__PRIMARY__USERNAME=root
DATABASE__CONNECTIONS__PRIMARY__PASSWORD=

CACHE__DEFAULT=memory

QUEUE__DEFAULT=sync
